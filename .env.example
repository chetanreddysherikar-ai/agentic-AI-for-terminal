# --- model provider (required) ---
GOOGLE_API_KEY="your-gemini-key"

# --- optional: web search (add one to enable the web_search tool) ---
# TAVILY_API_KEY=""
# SERPER_API_KEY=""

# --- optional: agent tuning ---
AGENT_NAME="CRS"
AGENT_MODEL="google_genai:gemini-3.5-flash-lite"
# Comma-separated; used in order when the primary model errors (e.g. quota)
AGENT_MODEL_FALLBACKS="google_genai:gemini-3.1-flash-lite,google_genai:gemini-flash-lite-latest,google_genai:gemma-4-26b-a4b-it"
AGENT_WORKSPACE="."
AGENT_MAX_STEPS=25
AGENT_TEMPERATURE=0.2

# --- security ---
# Ask for approval before run_python / run_shell / delete_path
AGENT_REQUIRE_APPROVAL=true
# Block outbound network access (disables fetch_url and web_search)
AGENT_ALLOW_NETWORK=true
# Allow writes, edits and deletes (false = read-only agent)
AGENT_ALLOW_DESTRUCTIVE=true
# Mask secret-looking values in tool output
AGENT_REDACT_SECRETS=true
# Enable the shell tool (off by default)
AGENT_ALLOW_SHELL=false
# Let tools touch files outside the workspace (off by default)
AGENT_ALLOW_OUTSIDE_WORKSPACE=false
# Where the audit trail is written
# AGENT_AUDIT_LOG=".agent/audit.log"
